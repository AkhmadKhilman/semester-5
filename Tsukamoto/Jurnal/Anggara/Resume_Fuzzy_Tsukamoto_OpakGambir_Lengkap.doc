<![endif]-->
<style>
  @page Section1 { size: 21cm 29.7cm; margin: 2cm; }
  div.Section1 { page: Section1; }
  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 11pt;
    line-height: 1.5;
    color: #1e293b;
    background-color: #f8fafc;
    margin: 0;
    padding: 15px;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
    background: #ffffff;
    padding: 30px;
    border-radius: 10px;
  }
  h1 {
    font-size: 15pt;
    color: #0f172a;
    text-align: center;
    border-bottom: 2.5pt solid #2563eb;
    padding-bottom: 8pt;
    margin-bottom: 4pt;
    text-transform: uppercase;
  }
  .subtitle { text-align: center; font-size: 10.5pt; color: #64748b; margin-bottom: 20pt; }
  
  .slide-box {
    border: 1.5pt solid #cbd5e1;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 20px;
    background: #ffffff;
  }
  .slide-header {
    border-bottom: 1.5pt solid #e2e8f0;
    padding-bottom: 6px;
    margin-bottom: 12px;
  }
  .slide-title {
    font-size: 13pt;
    font-weight: bold;
    color: #1e3a8a;
  }
  .badge-red { background: #ef4444; color: #fff; padding: 2px 8px; border-radius: 3px; font-weight: bold; font-size: 9.5pt; }
  .badge-blue { background: #2563eb; color: #fff; padding: 2px 8px; border-radius: 3px; font-weight: bold; font-size: 9.5pt; }
  .badge-green { background: #10b981; color: #fff; padding: 2px 8px; border-radius: 3px; font-weight: bold; font-size: 9.5pt; }
  
  .yellow-box {
    background-color: #fef08a;
    border: 1pt solid #fde047;
    color: #713f12;
    padding: 8px 12px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 10.5pt;
    margin-bottom: 12px;
  }
  .correction-box {
    background-color: #fff1f2;
    border-left: 3.5pt solid #f43f5e;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 9.5pt;
    color: #881337;
    margin-top: 10px;
  }
  
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 10px 0;
    font-size: 10pt;
  }
  th { background-color: #1e40af; color: #ffffff; padding: 7px 9px; border: 1pt solid #cbd5e1; text-align: center; }
  td { border: 1pt solid #cbd5e1; padding: 6px 9px; text-align: center; }
  tr:nth-child(even) { background-color: #f8fafc; }
  
  .formula-block {
    background: #f8fafc;
    border: 1pt solid #cbd5e1;
    border-radius: 5px;
    padding: 8px 12px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 10pt;
    color: #0f172a;
    line-height: 1.5;
  }
  
  .result-banner {
    background-color: #10b981;
    color: white;
    padding: 14px 18px;
    border-radius: 6px;
    text-align: center;
    font-size: 12pt;
    font-weight: bold;
    margin-top: 12px;
  }
</style>
