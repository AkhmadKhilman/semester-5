            <line x1="45" y1="145" x2="45" y2="30" stroke="#334155" stroke-width="1.8"/>
            <polyline points="45,145 95,145 285,35 330,35" fill="none" stroke="#2563eb" stroke-width="2.5"/>

            <line x1="45" y1="126.1" x2="127.5" y2="126.1" stroke="#ef4444" stroke-dasharray="3,3" stroke-width="1.5"/>
            <line x1="127.5" y1="126.1" x2="127.5" y2="145" stroke="#ef4444" stroke-dasharray="3,3" stroke-width="1.8"/>
            <circle cx="127.5" cy="126.1" r="3.5" fill="#ef4444"/>

            <text x="35" y="129" font-size="9" font-weight="bold" fill="#ef4444" font-family="monospace" text-anchor="end">0.17</text>
