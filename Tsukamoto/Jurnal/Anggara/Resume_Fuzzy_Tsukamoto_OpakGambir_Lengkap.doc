            <text x="135" y="172" font-size="9" font-weight="bold" fill="#ef4444" font-family="monospace" text-anchor="middle">z₄=3514</text>
            <text x="285" y="160" font-size="9" font-family="monospace" text-anchor="middle">6000</text>
